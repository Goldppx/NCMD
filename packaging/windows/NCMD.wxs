<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="NCMD"
      Language="1033"
      Version="@NCMD_MSI_VERSION@"
      Manufacturer="NCMD"
      UpgradeCode="B6B4B0C0-1649-4A9D-BA2B-945DAAEBFA24">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of NCMD is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="NCMD" />
      </Directory>
    </Directory>

    <Feature Id="NCMD" Title="NCMD" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
    </Feature>
  </Product>
</Wix>

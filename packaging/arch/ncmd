#!/usr/bin/env bash
# NCMD deliberately uses a system-managed Java runtime.  Do not bundle a JRE
# here: that makes security updates the responsibility of the distribution.
set -euo pipefail

readonly APP_HOME=/opt/ncmd
readonly APP_DIR="${APP_HOME}/lib/app"
readonly MAIN_CLASS=com.gem.neteasecloudmd.desktop.MainKt

show_error() {
  local message=$1
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title=NCMD --text="${message}" || true
  elif command -v kdialog >/dev/null 2>&1; then
    kdialog --error "${message}" --title NCMD || true
  fi
  printf '%s\n' "${message}" >&2
}

find_java() {
  if [[ -n "${NCMD_JAVA_HOME:-}" && -x "${NCMD_JAVA_HOME}/bin/java" ]]; then
    printf '%s\n' "${NCMD_JAVA_HOME}/bin/java"
  elif [[ -n "${JAVA_HOME:-}" && -x "${JAVA_HOME}/bin/java" ]]; then
    printf '%s\n' "${JAVA_HOME}/bin/java"
  else
    command -v java || true
  fi
}

java_bin=$(find_java)
if [[ -z "${java_bin}" ]]; then
  show_error 'NCMD requires a system Java 21 runtime. Install one with your package manager, then start NCMD again.'
  exit 1
fi

java_version=$(
  "${java_bin}" -version 2>&1 |
    sed -nE 's/.*version "([0-9]+).*/\1/p' |
    head -n 1
)
if [[ -z "${java_version}" || "${java_version}" -lt 21 ]]; then
  show_error 'NCMD requires Java 21 or newer. Update the Java runtime managed by your system package manager.'
  exit 1
fi

java_properties=$("${java_bin}" -XshowSettings:properties -version 2>&1 || true)
if [[ "${XDG_SESSION_TYPE:-}" == wayland && -n "${WAYLAND_DISPLAY:-}" ]] &&
  ! grep -q 'java.vendor = JetBrains s.r.o.' <<<"${java_properties}"; then
  show_error 'NCMD needs JetBrains Runtime 21 for native Wayland support. On Arch, install an AUR JetBrains Runtime package (for example jre21-jetbrains-git), then set NCMD_JAVA_HOME if it is not the default Java.'
  exit 1
fi

if [[ ! -d "${APP_DIR}" ]]; then
  show_error "NCMD installation is incomplete: ${APP_DIR} is missing. Reinstall the ncmd package."
  exit 1
fi

exec "${java_bin}" \
  -Djpackage.app-version=@NCMD_VERSION@ \
  -Dcompose.application.resources.dir="${APP_DIR}/resources" \
  -Dcompose.application.configure.swing.globals=true \
  -Dskiko.library.path="${APP_DIR}" \
  -cp "${APP_DIR}/*" \
  "${MAIN_CLASS}" "$@"

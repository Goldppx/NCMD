# Maintained by the NCMD repository. Java is intentionally supplied by the system.
pkgname=ncmd
pkgver=${NCMD_VERSION:-0.0.7}
pkgrel=3
pkgdesc='A Kotlin Multiplatform music client'
arch=('x86_64')
url='https://github.com/Goldppx/NCMD'
license=('MIT')
depends=(
  'alsa-lib'
  'fontconfig'
  'freetype2'
  'libglvnd'
  'libx11'
  'libxext'
  'libxi'
  'libxrender'
  'libxtst'
  'java-runtime>=21'
  'wayland'
  'xdg-utils'
)
optdepends=(
  'jre21-jetbrains-git: native Wayland runtime (AUR)'
  'zenity: graphical runtime error dialogs for GTK desktops'
  'kdialog: graphical runtime error dialogs for KDE Plasma'
)
options=('!strip')

package() {
  local app_dir="${startdir}/../../desktop/build/compose/binaries/main/app/NCMD"

  if [[ ! -d "${app_dir}/lib/app" ]]; then
    printf 'Missing Compose Desktop app image at %s\n' "${app_dir}" >&2
    return 1
  fi

  install -d "${pkgdir}/opt/ncmd/lib"
  cp -r "${app_dir}/lib/app" "${pkgdir}/opt/ncmd/lib/app"
  install -d "${pkgdir}/opt/ncmd/bin"
  sed "s/@NCMD_VERSION@/${pkgver}/" "${startdir}/ncmd" > "${pkgdir}/opt/ncmd/bin/ncmd"
  chmod 755 "${pkgdir}/opt/ncmd/bin/ncmd"
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/ncmd/bin/ncmd "${pkgdir}/usr/bin/ncmd"

  if [[ -f "${app_dir}/lib/ncmd-NCMD.desktop" ]]; then
    install -d "${pkgdir}/usr/share/applications"
    sed 's#Exec=.*#Exec=ncmd#' "${app_dir}/lib/ncmd-NCMD.desktop" > "${pkgdir}/usr/share/applications/ncmd.desktop"
  fi

  if [[ -f "${app_dir}/lib/NCMD.png" ]]; then
    install -Dm644 "${app_dir}/lib/NCMD.png" \
      "${pkgdir}/usr/share/pixmaps/ncmd.png"
  fi
}
